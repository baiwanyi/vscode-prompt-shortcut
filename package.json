{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "webian-prompt",
    "displayName": "微边提示词",
    "description": "AI 提示词管理器：一键把预设提示词发送到 CodeBuddy 对话；编辑器右键通过「使用 WebianCode 进行」子菜单提供修复、审查、优化、规范、重构。",
    "version": "0.1.0",
    "publisher": "Baiwanyi",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/baiwanyi/webian.prompt.git"
    },
    "homepage": "https://github.com/baiwanyi/webian.prompt#readme",
    "bugs": {
        "url": "https://github.com/baiwanyi/webian.prompt/issues"
    },
    "private": true,
    "icon": "resources/icon.png",
    "engines": {
        "vscode": "^1.144.0"
    },
    "categories": [
        "Other",
        "Machine Learning"
    ],
    "keywords": [
        "ai",
        "prompt",
        "codebuddy",
        "prompt-manager"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "webianPrompt.openSidebar",
                "title": "打开提示词面板",
                "category": "微边提示词",
                "icon": "$(list-unordered)"
            },
            {
                "command": "webianPrompt.newPrompt",
                "title": "新建提示词模板",
                "category": "微边提示词",
                "icon": "$(add)"
            },
            {
                "command": "webianPrompt.refresh",
                "title": "刷新提示词",
                "category": "微边提示词",
                "icon": "$(refresh)"
            },
            {
                "command": "webianPrompt.resetPrompts",
                "title": "恢复默认提示词",
                "category": "微边提示词",
                "icon": "$(history)"
            },
            {
                "command": "webianPrompt.fixWithCodeBuddy",
                "title": "修复",
                "category": "微边代码"
            },
            {
                "command": "webianPrompt.reviewWithCodeBuddy",
                "title": "审查",
                "category": "微边代码"
            },
            {
                "command": "webianPrompt.optimizeWithCodeBuddy",
                "title": "优化",
                "category": "微边代码"
            },
            {
                "command": "webianPrompt.styleWithCodeBuddy",
                "title": "规范",
                "category": "微边代码"
            },
            {
                "command": "webianPrompt.refactorWithCodeBuddy",
                "title": "重构",
                "category": "微边代码"
            }
        ],
        "submenus": [
            {
                "id": "webianPrompt.editorContext",
                "label": "使用 WebianCode 进行",
                "icon": "resources/icon.svg"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "submenu": "webianPrompt.editorContext",
                    "when": "editorTextFocus",
                    "group": "navigation@1.47"
                }
            ],
            "explorer/context": [
                {
                    "submenu": "webianPrompt.editorContext",
                    "when": "resourceScheme == file && !explorerResourceIsFolder",
                    "group": "1_webian@1"
                }
            ],
            "webianPrompt.editorContext": [
                {
                    "command": "webianPrompt.fixWithCodeBuddy",
                    "group": "1_webian@1"
                },
                {
                    "command": "webianPrompt.reviewWithCodeBuddy",
                    "group": "1_webian@2"
                },
                {
                    "command": "webianPrompt.optimizeWithCodeBuddy",
                    "group": "1_webian@3"
                },
                {
                    "command": "webianPrompt.styleWithCodeBuddy",
                    "group": "1_webian@4"
                },
                {
                    "command": "webianPrompt.refactorWithCodeBuddy",
                    "group": "1_webian@5"
                }
            ],
            "view/title": [
                {
                    "command": "webianPrompt.newPrompt",
                    "when": "view == webianPrompt.sidebar",
                    "group": "navigation@1"
                },
                {
                    "command": "webianPrompt.refresh",
                    "when": "view == webianPrompt.sidebar",
                    "group": "navigation@2"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "webianPrompt",
                    "title": "微边提示词",
                    "icon": "resources/icon.svg"
                }
            ]
        },
        "views": {
            "webianPrompt": [
                {
                    "type": "webview",
                    "id": "webianPrompt.sidebar",
                    "name": "微边提示词",
                    "icon": "resources/icon.svg"
                }
            ]
        },
        "configuration": {
            "title": "微边提示词",
            "properties": {
                "webianPrompt.codebuddy.reuseConversation": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "是否把提示词发送到 CodeBuddy 的当前对话。开启后不再每次新建会话标签；关闭后每次点击都会新建会话。"
                },
                "webianPrompt.codebuddy.sendCommand": {
                    "type": "string",
                    "default": "tencentcloud.codingcopilot.chat.sendMessage",
                    "markdownDescription": "复用当前对话时调用的命令 ID。默认使用 CodeBuddy 内置的 `chat.sendMessage`（发往当前会话，不新建会话）。若目标版本变更，可在此改为自定义命令。"
                },
                "webianPrompt.codebuddy.newChatCommand": {
                    "type": "string",
                    "default": "tencentcloud.codingcopilot.sendToChat",
                    "markdownDescription": "复用当前对话失败时用于新建会话的命令 ID。默认使用 CodeBuddy 内置的 `sendToChat`（新建对话并自动发送）。"
                },
                "webianPrompt.codebuddy.mode": {
                    "type": "string",
                    "enum": [
                        "craft",
                        "ask",
                        "plan"
                    ],
                    "default": "craft",
                    "markdownDescription": "发送提示词时使用的 CodeBuddy 对话模式。"
                },
                "webianPrompt.codebuddy.autoSend": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "点击提示词后是否直接触发发送。关闭后仅将文本写入剪贴板并聚焦 CodeBuddy 对话框，由你手动粘贴发送。"
                },
                "webianPrompt.codebuddy.fallbackToClipboard": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "当未检测到 CodeBuddy 扩展时，是否退化为「写入剪贴板 + 提示」。"
                }
            }
        }
    },
    "scripts": {
        "compile": "tsc --noEmit && node scripts/esbuild.mjs && vite build",
        "watch": "concurrently -k -n ts,host,web -c yellow,blue,green \"tsc6 --noEmit --watch\" \"node scripts/esbuild.mjs --watch\" \"vite build --watch\"",
        "typecheck": "tsc6 --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "verify": "pnpm run typecheck && pnpm run lint && prettier --check .",
        "package": "pnpm run compile && vsce package --no-dependencies --out releases/"
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "^5.28.8",
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/vscode": "1.144.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "^6.1.2",
        "@vscode/vsce": "^4.1.0",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.1",
        "concurrently": "^10.0.6",
        "esbuild": "^0.28.2",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.13.0",
        "lucide-react": "^1.65.0",
        "next-themes": "^0.4.6",
        "prettier": "^3.9.10",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "sonner": "^2.0.8",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5"
    }
}
