{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "vscode-prompt-shortcut",
    "displayName": "VSCode Prompt Shortcut",
    "description": "CodeBuddy 代码开发提示词快捷方式",
    "version": "0.1.0",
    "publisher": "Baiwanyi",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/baiwanyi/vscode-prompt-shortcut.git"
    },
    "homepage": "https://github.com/baiwanyi/vscode-prompt-shortcut#readme",
    "bugs": {
        "url": "https://github.com/baiwanyi/vscode-prompt-shortcut/issues"
    },
    "private": true,
    "icon": "resources/icon.png",
    "engines": {
        "vscode": "^1.144.0"
    },
    "categories": [
        "Other",
        "Machine Learning"
    ],
    "keywords": [
        "ai",
        "prompt",
        "codebuddy",
        "prompt-manager"
    ],
    "main": "./dist/extension.js",
    "activationEvents": [
        "onStartupFinished"
    ],
    "contributes": {
        "commands": [
            {
                "command": "baiwanyi.prompt.openSidebar",
                "title": "打开提示词面板",
                "category": "提示词快捷方式",
                "icon": "$(list-unordered)"
            },
            {
                "command": "baiwanyi.prompt.create",
                "title": "新建提示词模板",
                "category": "提示词快捷方式",
                "icon": "$(add)"
            },
            {
                "command": "baiwanyi.prompt.refresh",
                "title": "刷新提示词",
                "category": "提示词快捷方式",
                "icon": "$(refresh)"
            },
            {
                "command": "baiwanyi.prompt.reset",
                "title": "恢复默认提示词",
                "category": "提示词快捷方式",
                "icon": "$(history)"
            },
            {
                "command": "baiwanyi.prompt.fixWithCodeBuddy",
                "title": "修复缺陷",
                "category": "提示词快捷方式",
                "icon": "$(wrench)"
            },
            {
                "command": "baiwanyi.prompt.reviewWithCodeBuddy",
                "title": "代码评审",
                "category": "提示词快捷方式",
                "icon": "$(shield)"
            },
            {
                "command": "baiwanyi.prompt.optimizeWithCodeBuddy",
                "title": "实现优化",
                "category": "提示词快捷方式",
                "icon": "$(zap)"
            },
            {
                "command": "baiwanyi.prompt.styleWithCodeBuddy",
                "title": "编码规范",
                "category": "提示词快捷方式",
                "icon": "$(checklist)"
            },
            {
                "command": "baiwanyi.prompt.refactorWithCodeBuddy",
                "title": "代码重构",
                "category": "提示词快捷方式",
                "icon": "$(symbol-structure)"
            }
        ],
        "submenus": [
            {
                "id": "baiwanyi.prompt.editorContext",
                "label": "快捷命令",
                "icon": "resources/icon.svg"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "submenu": "baiwanyi.prompt.editorContext",
                    "when": "editorTextFocus",
                    "group": "0_a_quickcommand@1"
                }
            ],
            "explorer/context": [
                {
                    "submenu": "baiwanyi.prompt.editorContext",
                    "when": "resourceScheme == file && !explorerResourceIsFolder",
                    "group": "1_quickcommand@1"
                }
            ],
            "baiwanyi.prompt.editorContext": [
                {
                    "command": "baiwanyi.prompt.fixWithCodeBuddy",
                    "group": "1_quality@1"
                },
                {
                    "command": "baiwanyi.prompt.reviewWithCodeBuddy",
                    "group": "1_quality@2"
                },
                {
                    "command": "baiwanyi.prompt.optimizeWithCodeBuddy",
                    "group": "1_quality@3"
                },
                {
                    "command": "baiwanyi.prompt.styleWithCodeBuddy",
                    "group": "1_quality@4"
                },
                {
                    "command": "baiwanyi.prompt.refactorWithCodeBuddy",
                    "group": "2_structure@1"
                }
            ],
            "view/title": [
                {
                    "command": "baiwanyi.prompt.create",
                    "when": "view == baiwanyi.prompt.sidebar",
                    "group": "navigation@1"
                },
                {
                    "command": "baiwanyi.prompt.refresh",
                    "when": "view == baiwanyi.prompt.sidebar",
                    "group": "navigation@2"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "baiwanyi.prompt",
                    "title": "提示词快捷方式",
                    "icon": "resources/icon.svg"
                }
            ]
        },
        "views": {
            "baiwanyi.prompt": [
                {
                    "type": "webview",
                    "id": "baiwanyi.prompt.sidebar",
                    "name": "提示词快捷方式",
                    "icon": "resources/icon.svg"
                }
            ]
        },
        "configuration": {
            "title": "提示词快捷方式",
            "properties": {
                "baiwanyi.prompt.codebuddy.reuseConversation": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "是否把提示词发送到 CodeBuddy 的当前对话。开启后不再每次新建会话标签；关闭后每次点击都会新建会话。"
                },
                "baiwanyi.prompt.codebuddy.sendCommand": {
                    "type": "string",
                    "default": "tencentcloud.codingcopilot.chat.sendMessage",
                    "markdownDescription": "复用当前对话时调用的命令 ID。默认使用 CodeBuddy 内置的 `chat.sendMessage`（发往当前会话，不新建会话）。若目标版本变更，可在此改为自定义命令。"
                },
                "baiwanyi.prompt.codebuddy.newChatCommand": {
                    "type": "string",
                    "default": "tencentcloud.codingcopilot.sendToChat",
                    "markdownDescription": "复用当前对话失败时用于新建会话的命令 ID。默认使用 CodeBuddy 内置的 `sendToChat`（新建对话并自动发送）。"
                },
                "baiwanyi.prompt.codebuddy.mode": {
                    "type": "string",
                    "enum": [
                        "craft",
                        "ask",
                        "plan"
                    ],
                    "default": "craft",
                    "markdownDescription": "右键菜单动作未预设模式时使用的默认对话模式。侧边栏卡片始终按各自选定的模式发送，不受此项影响。"
                },
                "baiwanyi.prompt.codebuddy.autoSend": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "点击提示词后是否直接触发发送。关闭后仅将文本写入剪贴板并聚焦 CodeBuddy 对话框，由你手动粘贴发送。"
                },
                "baiwanyi.prompt.codebuddy.fallbackToClipboard": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "当未检测到 CodeBuddy 扩展时，是否退化为「写入剪贴板 + 提示」。"
                },
                "baiwanyi.prompt.update.checkOnStartup": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "是否在启动时检查自建清单里的新版本。市场安装的版本由 VS Code 自动更新，通常无需开启。"
                },
                "baiwanyi.prompt.update.manifestUrl": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "自建更新清单地址，需返回含 `version` 与 `url` 的 JSON（仅接受 https）。默认留空；仅在绕开市场分发（内网、离线镜像）时才需要填写。"
                }
            }
        }
    },
    "scripts": {
        "compile": "tsc --noEmit && node scripts/esbuild.mjs && vite build",
        "watch": "concurrently -k -n ts,host,web -c yellow,blue,green \"tsc6 --noEmit --watch\" \"node scripts/esbuild.mjs --watch\" \"vite build --watch\"",
        "typecheck": "tsc6 --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "verify": "pnpm run typecheck && pnpm run lint && prettier --check .",
        "package": "pnpm run compile && node scripts/package.mjs",
        "release": "node scripts/release.mjs"
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "^5.28.8",
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/vscode": "1.144.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "^6.1.2",
        "@vscode/vsce": "^4.1.0",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.1",
        "concurrently": "^10.0.6",
        "esbuild": "^0.28.2",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.13.0",
        "lucide-react": "^1.65.0",
        "prettier": "^3.9.10",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "sonner": "^2.0.8",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5"
    }
}
